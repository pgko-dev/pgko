{
  "name": "@pgko-dev/pgko",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts web",
    "dev:web": "bun scripts/dev.ts web",
    "dev:worker": "bun scripts/dev.ts worker",
    "dev:openapi": "bun run build:packages && bun run --cwd apps/openapi build && bun run --cwd apps/openapi preview",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun scripts/build.ts",
    "build:apps": "bun run --sequential --filter './apps/*' build",
    "build:web": "bun run build:packages && bun run --cwd apps/web build",
    "build:worker": "bun run build:packages && bun run --cwd apps/worker build",
    "build:openapi": "bun run build:packages && bun run --cwd apps/openapi build",
    "tsc": "tsc --noEmit && bun run --sequential --workspaces --if-present tsc",
    "test": "bun run --sequential --filter './apps/*' --if-present test && bun test ./packages",
    "test:coverage": "bun run --sequential --workspaces --if-present test:coverage && bun test ./packages --coverage --coverage-reporter=lcov",
    "lint": "oxlint .",
    "fmt": "oxfmt --check",
    "fmt:w": "oxfmt",
    "check": "bun run deps:check && bun run build:packages && bun scripts/check-release.ts && bun run tsc && bun run lint && bun run fmt && bun run test && bun run build:apps",
    "check:packages": "bun run deps:check && bun run build:packages && tsc --noEmit && bun run --sequential --filter './packages/*' --if-present tsc && bun test ./packages",
    "release:check": "bun run check:packages && bun run lint && bun run fmt && bun scripts/check-release.ts && bun run pack:check",
    "pack:check": "bun scripts/pack-check.ts",
    "version:packages": "bun scripts/version.ts",
    "i18n:unused": "bun packages/i18n/scripts/find-unused-i18n.ts",
    "deps:check": "syncpack lint",
    "deps:sync": "syncpack fix && bun install --ignore-scripts && bun run deps:check"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@mantine/hooks": "^9.6.3",
    "@mdx-js/rollup": "^3.1.1",
    "@scalar/api-reference": "1.72.4",
    "@sentry/react": "^11.2.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "dayjs": "^1.11.23",
    "get-user-locale": "^3.0.0",
    "i18next": "^26.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "^19.3.0",
    "react-cookie": "^8.1.2",
    "react-dom": "^19.3.0",
    "react-fast-marquee": "^1.6.5",
    "react-i18next": "^17.0.15",
    "react-image-crop": "^11.1.2",
    "recharts": "3.10.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "syncpack": "15.3.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "universal-cookie": "^8.1.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.2",
    "wrangler": "4.146.0",
    "@playwright/test": "1.62.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
