{
  "name": "@pgko.dev/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx vite build",
    "dev": "bunx vite",
    "test": "bun test --parallel",
    "test:coverage": "bun test --parallel --coverage --coverage-reporter=lcov",
    "tsc": "tsc -b && tsc -p e2e/tsconfig.browser.json && tsc -p e2e/tsconfig.node.json && tsc -p bench/ugc-render/tsconfig.json",
    "lint": "oxlint .",
    "fmt": "oxfmt --check .",
    "fmt:w": "oxfmt .",
    "check": "bun run lint && bun run fmt && bun run tsc && bun run test && bun run build",
    "check:coverage": "bun run lint && bun run fmt && bun run tsc && bun run test:coverage && bun run build",
    "test:browser": "playwright test",
    "bench:ugc": "bun bench/ugc-render/run.ts",
    "dev:preview": "bun run --cwd ../.. build:packages && vite --config e2e/vite.config.ts --host 127.0.0.1 --port 43179 --strictPort",
    "doctor": "npx react-doctor@latest"
  },
