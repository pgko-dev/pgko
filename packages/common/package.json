  },
  "dependencies": {
    "@pgko-dev/config": "workspace:*",
    "@pgko-dev/schema": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@pgko-dev/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
