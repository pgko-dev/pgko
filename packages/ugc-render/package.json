{
  "name": "@pgko.dev/ugc-render",
  "version": "0.2.2",
  "description": "UMIGURI chart parsing, multi-column Canvas rendering and browser playback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgko-dev/pgko.git",
    "directory": "packages/ugc-render"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./playback": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit",
    "test": "bun test src"
  },
  "devDependencies": {
    "@pgko.dev/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
